# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/testdi_db?retryWrites=true&w=majority
MONGODB_URI_LOCAL=mongodb://localhost:27017/testdi_db

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRE=7d

# Guest ID (for tracking guest users)
GUEST_ID_PREFIX=GUEST_

# Email (for notifications - optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# CORS
FRONTEND_URL=http://localhost:3000
